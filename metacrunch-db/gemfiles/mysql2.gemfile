# frozen_string_literal: true

# The bundle with mysql2, which needs the MySQL client library (libmysqlclient-dev, or MariaDB Connector/C). It has
# SQLite for the unit tests and no other driver, so a run with it adds only the tests against MySQL and MariaDB with
# mysql2:
#   BUNDLE_GEMFILE=gemfiles/mysql2.gemfile bundle exec rake test
source "https://rubygems.org"

gemspec path: ".."

# The core gem lives next to this one in the monorepo.
gem "metacrunch", path: "../../metacrunch"

gem "mysql2", ">= 0.5.6"
gem "sqlite3", ">= 2.0"

group :development do
  gem "minitest", ">= 5.25"
  gem "rake", ">= 13.0"
  gem "rubocop-ubpb", github: "ubpb/rubocop-ubpb", require: false
  gem "simplecov", ">= 0.22", require: false
end
