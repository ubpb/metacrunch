# frozen_string_literal: true

# The bundle with the drivers for MySQL and MariaDB: mysql2, which needs the MySQL client library (libmysqlclient-dev,
# or MariaDB Connector/C), and trilogy, which needs OpenSSL. With SQLite for the unit tests and no other driver, a run
# with it adds only the tests against MySQL and MariaDB (see test/compose.yml):
#   BUNDLE_GEMFILE=gemfiles/mysql.gemfile bundle exec rake test
source "https://rubygems.org"

gemspec path: ".."

# The core gem lives next to this one in the monorepo.
gem "metacrunch", path: "../../metacrunch"

gem "mysql2", ">= 0.5.6"
gem "sqlite3", ">= 2.0"
gem "trilogy", ">= 2.9"

group :development do
  gem "minitest", ">= 5.25"
  gem "rake", ">= 13.0"
  gem "rubocop-ubpb", github: "ubpb/rubocop-ubpb", require: false
  gem "simplecov", ">= 0.22", require: false
end
