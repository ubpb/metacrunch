# frozen_string_literal: true

source "https://rubygems.org"

gemspec

# The core gem lives next to this one in the monorepo.
gem "metacrunch", path: "../metacrunch"

# The drivers of the tests: SQLite for every test, pg against PostgreSQL (see test/compose.yml); both come
# precompiled for released Rubies. gemfiles/mysql.gemfile has the drivers for MySQL and MariaDB, which are compiled.
gem "pg", ">= 1.5"
gem "sqlite3", ">= 2.0"

group :development do
  gem "minitest", ">= 5.25"
  gem "rake", ">= 13.0"
  gem "rubocop-ubpb", github: "ubpb/rubocop-ubpb", require: false
  gem "simplecov", ">= 0.22", require: false
end
