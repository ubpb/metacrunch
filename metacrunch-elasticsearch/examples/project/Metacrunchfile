# frozen_string_literal: true

# A project with the gem's commands (es:create-index, es:switch-alias, ...) and its own:
#
#   bundle exec metacrunch --help
#   bundle exec metacrunch books:rebuild        # a new index for the alias books, loaded and switched to
#   bundle exec metacrunch books:load --index books --input more.jsonl   # an update through the alias
#   bundle exec metacrunch es:list "books*"
require "metacrunch/elasticsearch"

Metacrunch.load_files Metacrunch::Elasticsearch::COMMANDS, "jobs/**/*.rb", "commands/**/*.rb"
