#!/usr/bin/env ruby
# frozen_string_literal: true

require "metacrunch/cli"

code = Metacrunch::Cli.new.run(ARGV)

# After Ctrl-C or SIGTERM (exit code 128 + signal number), end by the signal
# itself, so callers such as shells, xargs or make see the interruption.
# Raising SignalException (instead of killing the process) lets Ruby flush
# stdout and run at_exit hooks first, then re-raise the signal without
# printing anything.
signal = code > 128 && Signal.signame(code - 128)
raise SignalException, signal if signal

exit code
